meta {
  name: Create Subscription
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/subscriptions
  body: json
  auth: none
}

body:json {
  {
    "endpoint": "https://fcm.googleapis.com/fcm/send/example-endpoint",
    "keys": {
      "p256dh": "example-p256dh-key",
      "auth": "example-auth-secret"
    }
  }
}

docs {
  Mirrors browser PushSubscription.toJSON(). Idempotent: re-posting the
  same endpoint reactivates that row instead of erroring.
}
