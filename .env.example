# Copy this file to .env and fill in real values. Never commit .env itself.

# --- VAPID (Web Push) ---
# Generate with: python backend/scripts/generate_vapid_keys.py
VAPID_PRIVATE_KEY=replace-with-generated-private-key
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_CLAIMS_EMAIL=mailto:you@example.com

# --- Database ---
# SQLite for local dev; swap for a Postgres URL in production
# e.g. postgresql+psycopg://user:pass@host:5432/mindpulse
DATABASE_URL=sqlite+aiosqlite:///./mindpulse.db

# --- App ---
# Comma-separated list of origins allowed to call the API (CORS)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ENVIRONMENT=development
